{
  "name": "vmis-website",
  "version": "1.0.0",
  "private": true,
  "description": "Dr. VedPati Mishra Institute Of Scholars (VMIS) \u2014 bilingual school website, admissions and admin platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && tsc --noEmit",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "set-role": "node --env-file=.env.local scripts/set-role.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "restore": "node --env-file=.env.local scripts/restore.mjs",
    "check:logo": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}