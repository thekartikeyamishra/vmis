# ── Public site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to "true" to show the maintenance page to the public (admin stays available)
MAINTENANCE_MODE=false

# ── Firebase web app (Admin login only; safe to expose) ───────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (SERVER ONLY — never commit) ───────────
# Option A: whole service-account JSON, base64-encoded (PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) )
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option B: individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── Security ──────────────────────────────────────────────────
# Long random string used to hash IPs / phone numbers (privacy-preserving rate limits & duplicate checks)
HASH_SALT=change-me-to-a-long-random-string
# Bearer secret for the notification job runner (/api/jobs/notify), e.g. from a scheduler
CRON_SECRET=change-me-too

# ── Notifications (optional; default provider just logs) ──────
NOTIFY_PROVIDER=log            # log | resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_ADMISSIONS_EMAIL=
